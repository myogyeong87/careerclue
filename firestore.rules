rules_version = '2';

// 스펙 2장: 로그인/인증 없는 앱이라 규칙도 열어둠 (학급 내부용, 민감 정보 없음 전제).
service cloud.firestore {
  match /databases/{database}/documents {
    match /question_sets/{setId} {
      allow read, write: if true;
    }
    // 반(세션): 반 정보 + 게임 진행 상태. 하위 컬렉션 students·lobby·submissions·practice_submissions
    match /classes/{classId} {
      allow read, write: if true;

      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }
    // 반 구조 이전 전의 옛 위치. 기본 반으로 옮긴 뒤 교사가 설정에서 직접 정리할 때까지 남겨둠
    match /games/{gameId} {
      allow read, write: if true;

      // games/current/submissions: 실제 게임, games/practice/submissions: 연습 라운드
      match /submissions/{submissionId} {
        allow read, write: if true;
      }

      match /lobby/{studentId} {
        allow read, write: if true;
      }
    }
    match /roster/{studentId} {
      allow read, write: if true;
    }
    // 교사 PIN 해시 (config/teacherPin). 원문은 저장하지 않음
    match /config/{docId} {
      allow read, write: if true;
    }
  }
}
